{% extends "@Contao/mod_search.html.twig" %}

{% block content %}

    <div class="content-collection">
        <form{% if action|default %} action="{{ action }}"{% endif %} method="get">
            <div class="formbody">
                <div class="equal-columns equal-columns--columns-2 equal-columns--alignment-center">
                    <div class="widget widget-text">
                        <label for="ctrl_keywords_{{ uniqueId }}" class="invisible">{{ keywordLabel }}</label>
                        <input type="search" name="keywords" id="ctrl_keywords_{{ uniqueId }}" class="text"
                               value="{{ keyword }}" spellcheck="false">
                    </div>
                    <div class="widget widget-submit">
                        <button type="submit" id="ctrl_submit_{{ uniqueId }}"
                                class="button text-icon button--primary text-icon--icon-right submit">
                            <span class="button__text text-icon__text">{{ search }}</span>
                            <span class="button__icon text-icon__icon svg-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                    <circle cx="12" cy="12" r="11.5" class="button__icon-bg"></circle>
                                    <path d="M10 7l5 5-5 5" class="button__icon-arrow" fill="none"
                                          stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                </svg>
                            </span>
                        </button>
                    </div>

                    {% if advanced %}
                        <div class="widget widget-radio">
                            <fieldset class="radio_container">
                                <legend class="invisible">{{ optionsLabel }}</legend>
                                <span><input type="radio" name="query_type" id="matchAll_{{ uniqueId }}" class="radio"
                                             value="and"{% if 'and' == queryType %} checked{% endif %}> <label
                                            for="matchAll_{{ uniqueId }}">{{ matchAll }}</label></span>
                                <span><input type="radio" name="query_type" id="matchAny_{{ uniqueId }}" class="radio"
                                             value="or"{% if 'or' == queryType %} checked{% endif %}> <label
                                            for="matchAny_{{ uniqueId }}">{{ matchAny }}</label></span>
                            </fieldset>
                        </div>
                    {% endif %}
                </div>
            </div>
        </form>
    </div>

    {% if header|default %}
        <p class="header">{{ header|raw }}</p>
        {% if keywordHint|default %}
            <p class="info">{{ keywordHint }}</p>
        {% endif %}
    {% endif %}

    {{ results|raw }}
    {{ pagination|raw }}

{% endblock %}

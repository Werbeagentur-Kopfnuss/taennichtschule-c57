{% extends "@Contao/content_element/download.html.twig" %}
{% use "@Contao/component/_download.html.twig" %}

{% set download_link_attributes = attrs()
    .set('target', '_blank')
    .addClass('button')
    .addClass('text-icon')
    .addClass('button--accent')
    .mergeWith(download_link_attributes|default)
%}

{%- block download_link_inner %}
    {% if as_editor_view|default(false) %}
        {{ parent() }}
    {% else %}
        <span class="button__icon text-icon__icon svg-icon" aria-hidden="true">
            <svg viewBox="0 0 16 13" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                <path d="M15.7143 5.81205L10.0153 12.4138L4.87406 5.81205H8.23265C8.12926 4.89074 5.7513 -0.535438 0.763545 4.22667C0.760412 4.22966 0.754146 4.23265 0.751013 4.23565C0.315524 4.49888 -0.188891 4.01728 0.0711487 3.59252C0.64449 2.65326 1.45907 1.83963 2.46164 1.24736C2.46477 1.24736 2.4679 1.24138 2.47104 1.24138C3.62399 0.457665 5.03698 0 6.56275 0C10.1469 0 12.1834 2.69215 12.1834 5.81205H15.7112H15.7143Z" fill="currentcolor"/>
            </svg>
        </span>
        <span class="button__text text-icon__text">
            {{ parent() }}
        </span>
    {% endif %}
{% endblock -%}
        {% endblock %}
        <div{{ wrapperInnerAttributes }}>
            {% if printable %}
                {% block syndication %}
                    <!-- indexer::stop -->
                    <div class="syndication">
                        {% if printButton %}
                            <a href="{{ print }}" class="print" title="{{ printTitle }}"
                               onclick="window.print();return false"
                               data-skip-search-index>{{ backend_icon('assets/contao/images/print.svg') }}</a>
                        {% endif %}
                        {% if facebookButton %}
                            <a href="{{ path('contao_frontend_share', { p: 'facebook', u: encUrl }) }}" class="facebook"
                               rel="nofollow" title="{{ facebookTitle }}"
                               onclick="var w=window.open(this.href,'','width=640,height=380,modal=yes,left=100,top=50,location=no,menubar=no,resizable=yes,scrollbars=yes,status=no,toolbar=no');w.opener=null;return false">{{ backend_icon('assets/contao/images/facebook.svg') }}</a>
                        {% endif %}
                        {% if twitterButton %}
                            <a href="{{ path('contao_frontend_share', { p: 'twitter', u: encUrl, t: encTitle }) }}"
                               class="twitter" rel="nofollow" title="{{ twitterTitle }}"
                               onclick="var w=window.open(this.href,'','width=640,height=380,modal=yes,left=100,top=50,location=no,menubar=no,resizable=yes,scrollbars=yes,status=no,toolbar=no');w.opener=null;return false">{{ backend_icon('assets/contao/images/twitter.svg') }}</a>
                        {% endif %}
                    </div>
                    <!-- indexer::continue -->
                {% endblock %}
            {% endif %}

            {{ block('content') }}

            {% if backlink %}
                {% block backlink %}
                    <!-- indexer::stop -->
                    <p class="back"><a href="{{ backlink }}" title="{{ back }}">{{ back }}</a></p>
                    <!-- indexer::continue -->
                {% endblock %}
            {% endif %}
        </div>

{% set widthClass = width_variant is not empty ? 'wrapper--width-' ~ width_variant : 'wrapper--width-standard' %}
{% set backgroundClass = with_background_color is not empty ? 'background-color--' ~ with_background_color : '' %}
{% set decorClass = with_background ? 'decor-section' : '' %}
{% set decorClassInner = with_background ? 'decor-section__inner' : '' %}

{% set wrapperAttributes = attrs(cssID)
    .addClass([class, backgroundClass, decorClass, 'block'])
    .addStyle(style|default)
    .mergeWith(wrapperAttributes|default) %}

 {% set wrapperInnerAttributes = attrs()
     .addClass(['wrapper', 'content-block', decorClassInner, widthClass])
     .mergeWith(wrapperInnerAttributes|default) %}

{% if teaserOnly|default %}

    {% block alias %}
        <article{{ wrapperAttributes }}>
            <div class="ce_text block">
                <h2>{{ headline }}</h2>
                <div class="teaser">
                    {{ teaser|csp_inline_styles|raw }}
                    <p class="more"><a href="{{ href }}" title="{{ readMore }}">{{ more }} <span
                                    class="invisible">{{ headline }}</span></a></p>
                </div>
            </div>
        </article>
    {% endblock %}

{% elseif noMarkup|default %}

    {% block content %}
        {{ elements|join|raw }}
    {% endblock %}


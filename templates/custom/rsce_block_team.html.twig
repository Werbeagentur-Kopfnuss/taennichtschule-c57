{% use "@Contao/component/_figure.html.twig" %}

{% block rsce_team %}

    {#
        RSCE-Element: Team-Mitgliedsprofil
        Details: Bild, Name - Title, E-Mail, Telefon, Fax, Linklist, List, Link,
        Depends on: _c-link-list.css
    #}

    {% if hasImage|default(false) and hasImageMetadata|default(false) %}
        {% set metaImageAlt  = imageAlt|default %}
    {% elseif hasImage|default(false) %}
        {% set figure    = figure(image, {}) %}
        {% set metaImageAlt  = figure.metadata.alt|insert_tag %}
    {% endif %}

    {% set metaLinkAriaLabel = 'CUSTOM.rsce_team_link_aria'|trans({}, 'contao_default') ~ (name|default) %}

    <div class="team__card card {{ class }}"{% if cssID %} id="{{ cssID }}"{% endif %}>

        {% if image|default %}

        <div class="card__image">
            {% with { figure: figure(image, imageSize)} %}
                {% block figure_component %}
                    {% set img_attributes = attrs()
                        .set('alt', metaImageAlt)
                        .set('title', '')
                        .mergeWith(img_attributes|default)
                    %}
                    {{ parent() }}
                {% endblock %}
            {% endwith %}
        </div>

        {% endif %}

        <div class="team_headline">
            <{{ headlineOrder }} class="team__name" itemprop="name">
                {{ name }}
                <span class="team_titel"> {{ teamTitle }}</span>
            </{{ headlineOrder }}>
        </div>
        {% if telefon|default or emailList|default or fax|default or subject|default %}
        <div class="team__contact-info">
            <ul class="link-list">
                {% if telefon|default %}
                    {% set telefonOnly = telefon|replace({'+': '', ' ': '', '/': '', '-': ''}) %}

                    <li>
                        <a class="link-list__row text-icon text-icon--link" href="tel:{{ telefonOnly }}" aria-label="{{ 'CUSTOM.rsce_team_telefon_aria'|trans({}, 'contao_default') }} {{ telefon|default }}">
                            {% if 'isIcons' in hasIcons|default([]) %}
                                <span class="text-icon__icon svg-icon svg-icon--size-font" aria-hidden="true">
                                    <svg viewBox="0 0 21 22" xmlns="http://www.w3.org/2000/svg" focusable="false">
                                    <path d="M2.79093 1.21183L5.39793 0L9.10218 7.2325L6.60426 8.46175C6.1111 9.61583 8.58334 14.2267 9.62651 14.3027C9.70901 14.2496 12.0749 13.0854 12.0749 13.0854L15.8424 20.3564C15.8424 20.3564 13.3088 21.5976 13.2263 21.6361C6.02034 24.9278 -4.28299 4.89958 2.79093 1.21183ZM4.5601 2.37967L3.62235 2.84167C-1.23049 5.3735 7.45126 22.2612 12.4663 19.9705L13.3564 19.536L11.2747 15.5183L10.3342 15.9766C7.43476 17.3947 2.76068 8.4425 5.70043 6.86675L6.62351 6.41117L4.5601 2.37967ZM11.7394 9.39125L14.4133 10.1887C14.6178 9.504 14.56 8.74133 14.1933 8.06483C13.8276 7.38742 13.2198 6.92175 12.536 6.71825L11.7394 9.39125ZM13.3931 3.83717C14.8148 4.26067 16.0753 5.22683 16.8361 6.63392C17.5978 8.04192 17.7161 9.625 17.2926 11.0458L15.6472 10.5554C15.9451 9.55533 15.8608 8.44158 15.3245 7.45067C14.7901 6.45975 13.9028 5.7805 12.9018 5.4835L13.3931 3.83717ZM14.2639 0.916667C16.4318 1.56292 18.355 3.036 19.5155 5.18467C20.6788 7.33242 20.8593 9.74783 20.2131 11.9167L18.5264 11.4143C19.0434 9.67725 18.8986 7.74217 17.9691 6.0225C17.0378 4.30192 15.4978 3.12125 13.7607 2.60425L14.2639 0.916667Z" fill="black"/>
                                    </svg>
                                </span>
                            {% endif %}
                            <span class="text-icon__text">{{ telefon|default }}</span>
                        </a>
                    </li>
                {% endif %}
                {% if fax|default %}
                    <li>
                        <span class="link-list__row text-icon">
                            {% if 'isIcons' in hasIcons|default([]) %}
                                <span class="text-icon__icon svg-icon svg-icon--size-font" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
                                    <path d="M13.693 10.812l1.306 2.452-.928.492c-2.506 1.238-6.783-6.771-4.346-8.141l.936-.499 1.307 2.455-.926.493c-.734.427.974 3.633 1.727 3.238l.924-.49zm10.307.188v12h-24v-12h4v-10h10.328c1.538 0 5.672 4.852 5.672 6.031v3.969h4zm-18 5h12v-8.396c0-1.338-2.281-1.494-3.25-1.229.453-.813.305-3.375-1.082-3.375h-7.668v13zm16-3h-2v5h-16v-5h-2v8h20v-8z" fill="currentColor"/>
                                    </svg>
                                </span>
                            {% endif %}
                            <span class="text-icon__text">{{ fax|default }}</span>
                        </span>
                    </li>
                {% endif %}
                {% if emailList|default %}
                    {% for uuid3 in emailList %}
                        <li>
                            <a class="link-list__row text-icon text-icon--link" href="mailto:{{ uuid3.emailListEmail|default }}" aria-label="{{ 'CUSTOM.rsce_team_email_aria'|trans({}, 'contao_default') }} {{ uuid3.emailListEmail|default }}"  >
                                {% if 'isIcons' in hasIcons|default([]) %}
                                    <span class="text-icon__icon svg-icon svg-icon--size-font" aria-hidden="true">
                                        <svg viewBox="0 0 23 18" xmlns="http://www.w3.org/2000/svg" focusable="false">
                                        <path d="M0.5 0.75V17.25H22.5V0.75H0.5ZM20.2248 2.58333L11.5 9.65358L2.77517 2.58333H20.2248ZM2.33333 15.4167V4.58442L11.5 12.0131L20.6667 4.58442V15.4167H2.33333Z" fill="currentColor"/>
                                        </svg>
                                    </span>
                                {% endif %}
                                <span class="text-icon__text">{{ uuid3.emailListEmail|default }}</span>
                            </a>
                        </li>
                    {% endfor %}
                {% endif %}
                {% if subject|default %}
                    <li>
                        <span class="link-list__row text-icon">
                            {% if 'isIcons' in hasIcons|default([]) %}
                                <span class="text-icon__icon svg-icon svg-icon--size-font" aria-hidden="true" focusable="false">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 97.79 95.55">
                                        <path d="M82.37,95.55H10.33c-2.77,0-5.36-1.08-7.31-3.04-1.93-1.94-3-4.5-3.02-7.23V7.2c0-1.92.75-3.72,2.1-5.08C3.46.75,5.27,0,7.19,0h71c.9-.02,1.85.16,2.74.52.88.35,1.68.87,2.36,1.54.69.67,1.23,1.46,1.6,2.35.38.89.57,1.82.57,2.78v8.22c0,.78-.27,1.49-.73,2.04.42.54.67,1.22.67,1.96v.77c0,1.11-.56,2.09-1.42,2.67,8.11,3.23,13.79,10.58,13.79,19.09s-5.26,15.24-12.9,18.63c.41.54.65,1.21.66,1.94l.05,15.54v.52c0,1.16-.62,2.24-1.64,2.81-.12.07-.21.16-.28.28-.03.06-.06.11-.1.17-.61.97-.92,2.09-.9,3.23v.31h0v.05c0,1.13.3,2.22.9,3.17.03.05.07.11.1.16.07.12.17.22.3.3,1,.58,1.62,1.64,1.62,2.8v.48c0,1.78-1.44,3.23-3.23,3.23ZM10.33,81.31c-1.03,0-2.01.41-2.74,1.15-.72.73-1.14,1.73-1.14,2.75s.4,2.01,1.14,2.75c.73.74,1.71,1.14,2.75,1.14h66.44c-.37-1.2-.56-2.46-.55-3.74v-.25c-.02-1.28.17-2.57.55-3.8H10.33ZM8.76,6.45h-1.56c-.2,0-.39.08-.53.22-.14.14-.22.33-.22.53v68.42c1.22-.49,2.53-.75,3.88-.76h68.8l-.04-12.33c0-.07,0-.14,0-.21-1.42.25-2.89.38-4.39.38-3.73.06-7.5-.79-10.87-2.46-2.84-1.41-5.4-3.39-7.47-5.79l-12.92.71c-1.43.1-2.73-.79-3.21-2.12s-.03-2.83,1.11-3.69l10.29-7.66c.1-11.38,10.41-20.6,23.07-20.6.05,0,.11,0,.16,0,1.49,0,2.95.15,4.37.4-.18-.4-.28-.84-.28-1.31v-.77c0-.78.27-1.49.73-2.04-.42-.54-.67-1.22-.67-1.96V7.2c0-.08-.02-.19-.06-.28s-.1-.18-.17-.25c-.08-.07-.16-.13-.26-.17-.09-.04-.16-.05-.28-.05H15.21v54.37c0,1.06-.51,2.01-1.31,2.59.79.59,1.31,1.53,1.31,2.59v.85c0,1.78-1.44,3.23-3.23,3.23s-3.23-1.44-3.23-3.23v-.85c0-1.06.51-2.01,1.31-2.59-.79-.59-1.31-1.53-1.31-2.59V6.45ZM57.85,47.91c1.02,0,1.99.48,2.6,1.31,1.63,2.21,3.79,4.02,6.25,5.24s5.22,1.86,7.96,1.79c9.22,0,16.68-6.42,16.68-14.3s-7.46-14.4-16.62-14.4c-.05,0-.09,0-.14,0-9.1.06-16.48,6.45-16.48,14.29,0,.35.02.71.06,1.04.13,1.14-.35,2.27-1.28,2.96l-3.08,2.3,3.88-.21c.06,0,.12,0,.18,0ZM82.32,53.64h-14.95c-1.78,0-3.23-1.44-3.23-3.23s1.44-3.23,3.23-3.23h14.95c1.78,0,3.23,1.44,3.23,3.23s-1.44,3.23-3.23,3.23ZM82.32,46.02h-14.95c-1.78,0-3.23-1.44-3.23-3.23s1.44-3.23,3.23-3.23h14.95c1.78,0,3.23,1.44,3.23,3.23s-1.44,3.23-3.23,3.23ZM82.32,38.4h-14.95c-1.78,0-3.23-1.44-3.23-3.23s1.44-3.23,3.23-3.23h14.95c1.78,0,3.23,1.44,3.23,3.23s-1.44,3.23-3.23,3.23ZM62.15,21.71H23.44c-1.78,0-3.23-1.44-3.23-3.23v-6.19c0-1.78,1.44-3.23,3.23-3.23h38.71c1.78,0,3.23,1.44,3.23,3.23v6.19c0,1.78-1.44,3.23-3.23,3.23Z" fill="currentColor"/>
                                    </svg>
                                </span>
                            {% endif %}
                            <span class="text-icon__text">{{ subject|default }}</span>
                        </span>
                    </li>
                {% endif %}
            </ul>
        </div>
        {% endif %}
        {% if links|default %}
            <ul class="link-list team__link-list">
                {% for uuid in links %}
                    <li>
                        <a href="{{ uuid.linkListUrl|default|insert_tag }}"{% if uuid.linkListAriaLabel|default %} aria-label="{{ uuid.linkListAriaLabel|default }}"{% endif %}>
                            <span class="link-list__icon" aria-hidden="true">
                                <svg viewBox="0 0 18 14" fill="none">
                                    <path d="M11.525 13.7928C11.525 13.7928 16.026 9.2878 17.779 7.5338C17.926 7.3878 17.999 7.1958 17.999 7.0038C17.999 6.8118 17.926 6.6198 17.779 6.4738C16.027 4.7198 11.527 0.216802 11.527 0.216802C11.382 0.0718016 11.191 -0.000198959 11 -0.000198976C10.809 0.000801412 10.617 0.0738013 10.47 0.220802C10.177 0.513802 10.176 0.9868 10.466 1.2778L15.442 6.2538L0.750024 6.2538C0.336024 6.2538 2.35367e-05 6.5898 2.35005e-05 7.0038C2.34643e-05 7.4178 0.336024 7.7538 0.750023 7.7538L15.442 7.7538L10.464 12.7328C10.175 13.0218 10.177 13.4938 10.47 13.7868C10.617 13.9338 10.809 14.0078 11 14.0078C11.191 14.0088 11.38 13.9368 11.525 13.7928Z"></path>
                                </svg>
                            </span>
                            <span class="link-list__text">{{ uuid.linkListName }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if list|default %}
            <{{ headlineOrderList }} class="team__headline-list">{{ headlineListName }}</{{ headlineOrderList }}>
            <ul class="team__list">
                {% for uuid2 in list %}
                    <li>{{ uuid2.listEntry }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if hasLink|default == true %}
            {% if url|default %}
                <a class="team__link" href="{{ url|default|insert_tag }}" aria-label="{{ metaLinkAriaLabel }}">
                    <span>{{ 'CUSTOM.rsce_team_more'|trans({}, 'contao_default') }}</span>
                </a>
            {% endif %}
        {% endif %}

    </div>
{% endblock %}

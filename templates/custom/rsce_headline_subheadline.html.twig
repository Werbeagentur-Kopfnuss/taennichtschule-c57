{% block headline_subheadline %}
	<div class="{{ class }}"{% if cssID %} id="{{ cssID }}"{% endif %}>

		<{{ headlineOrder }} class="content-headline headline-subheadline">
			{% if subheadlineTopBottom == 'isTop' %}
				<span class="headline-top">{{ headlineTop }}</span>
			{% endif %}
			{{ headline }}
			{% if subheadlineTopBottom == 'isBottom' %}
				<span class="headline-bottom">{{ headlineBottom }}</span>
			{% endif %}
		</{{ headlineOrder }}>

	</div>
{% endblock %}